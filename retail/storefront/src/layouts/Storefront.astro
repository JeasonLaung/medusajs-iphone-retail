---
import Header from '../components/layout/gin-header'
import SeoHead from '../components/layout/seo-head.astro'
import {STOREFRONT_ORIGIN,CUSTOMER_BRIDGE_KEY} from 'astro:env/server'
import Footer from '../components/layout/footer'
import type {Region} from '../lib/regions'
import type {Locale} from '../lib/preferences'
import type {FooterData} from '../lib/footer-data'
import {localeFromSegment} from '../lib/storefront-route'
import {localePreferenceCookie,localePreferenceAge,routePreferenceCookie} from '../lib/preference-save'
import '../styles/original.css'

export interface Props {
 segment:string
 title:string
 description?:string
 robots?:string
 canonicalPath?:string
 openGraph?:{title:string;description:string;images:string[]}
 shell?:{regions:Region[];locales:Locale[];footer:FooterData}
}
const {segment,title,description,robots,canonicalPath,openGraph,shell}=Astro.props
// Private cart/account hydration is connected separately; never serialize
// cookies, sessions or an upstream response in the public page's island props.
if(!Astro.response.headers.has('Cache-Control'))Astro.response.headers.set('Cache-Control','no-store')
const routeCookie=routePreferenceCookie(segment,Astro.cookies.get(localePreferenceCookie)?.value)
if(routeCookie!==undefined)Astro.cookies.set(localePreferenceCookie,routeCookie,{path:'/',maxAge:localePreferenceAge,httpOnly:false,sameSite:'strict',secure:Astro.url.protocol==='https:'})
---
<!doctype html>
<html lang={localeFromSegment(segment)}>
 <head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <SeoHead title={title} description={description} robots={robots} canonicalPath={canonicalPath} openGraph={openGraph}/>
 </head>
 <body>
  {shell && <Header customerEnabled={!!CUSTOMER_BRIDGE_KEY&&!!STOREFRONT_ORIGIN&&Astro.url.origin===STOREFRONT_ORIGIN} commerceEnabled={!!STOREFRONT_ORIGIN&&Astro.url.origin===STOREFRONT_ORIGIN} regions={shell.regions} locales={shell.locales} locale={localeFromSegment(segment)} segment={segment} pathname={Astro.url.pathname} cartCount="0" isLoggedIn={false} onSelect={null} client:load/>}
  <main id="main-content"><slot/></main>
  {shell && <Footer data={shell.footer} segment={segment}/>}
 </body>
</html>
