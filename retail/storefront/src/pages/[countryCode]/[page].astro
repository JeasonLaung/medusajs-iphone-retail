---
import {GIN_API_ORIGIN} from 'astro:env/server'
import Storefront from '../../layouts/Storefront.astro'
import {loadPublicPage} from '../../lib/public-page'
import {loadServiceContacts} from '../../lib/customer-service'
import Information from '../../components/information'
import CustomerService from '../../components/customer-service'
import Journal from '../../components/journal'
import {getHomeCopy} from '../../components/journal/i18n'
import {getLayoutCopy} from '../../components/layout/i18n'
const segment=(Astro.params.countryCode??'').toLowerCase()
const page=Astro.params.page
const locale=segment.endsWith('-zh')?'zh-CN':'en'
const copy=getLayoutCopy(locale),home=getHomeCopy(locale)
let shell:Awaited<ReturnType<typeof loadPublicPage>>=null
let unavailable=false
if(page==='about'||page==='help'||page==='blog'){
 try{shell=await loadPublicPage(GIN_API_ORIGIN,segment)}catch{unavailable=true}
}
let service:Awaited<ReturnType<typeof loadServiceContacts>>=[],serviceFailed=false
if(shell&&page==='help'){
 try{service=await loadServiceContacts(GIN_API_ORIGIN)}catch{serviceFailed=true}
}
if(unavailable)Astro.response.status=503
else if(!shell)Astro.response.status=404
const error=unavailable?(locale==='en'?'This page is temporarily unavailable. Please try again.':'页面暂时无法加载，请稍后重试。'):(locale==='en'?'Page not found':'未找到页面')
const title=page==='about'?copy.about:page==='help'?copy.help:home.blogTitle
const description=page==='about'?copy.aboutDescription:page==='help'?copy.helpDescription:home.blogDescription
---
<Storefront segment={segment} title={shell?`${title} | EuroRefurb`:error} description={shell?description:undefined} canonicalPath={shell?`/${segment}/${page}`:undefined} shell={shell??undefined}>
 {shell ? page==='blog'?<Journal segment={segment}/>:<Information kind={page==='help'?'help':'about'} segment={segment}>
  {page==='help'&&<CustomerService contacts={service} locale={locale} failed={serviceFailed} client:load/>}
 </Information> : <div class="content-container py-16"><h1>{error}</h1></div>}
</Storefront>
