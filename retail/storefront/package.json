{
  "name": "@eurorefurb/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 9300",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:product-page": "node tests/product-page.browser.mjs",
    "build": "npm run check && astro build",
    "start": "node dist/server/entry.mjs"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.1",
    "@headlessui/react": "2.2.10",
    "antd": "5.29.3",
    "astro": "7.4.2",
    "react": "19.2.8",
    "react-country-flag": "3.1.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.2"
  }
}
