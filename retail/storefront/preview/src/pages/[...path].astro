---
import Preview from '../preview'
import Footer from '../../../src/components/layout/footer'
import '../../../src/styles/original.css'
const segment=Astro.url.pathname.startsWith('/dk-en')?'dk-en':'dk-zh'
const data={iphoneCategory:{id:'iphone',name:'iPhone',handle:'iphone',category_children:[{id:'14',name:'iPhone 14',handle:'iphone-14'}]},collections:[]}
---
<!doctype html><html lang={segment.endsWith('-zh')?'zh-CN':'en'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>EuroRefurb · 迁移组件预览</title><link rel="icon" href="data:,"/></head><body><Preview segment={segment} initialLocation={Astro.url.pathname+Astro.url.search} client:load/><Footer data={data} segment={segment}/></body></html>
<style is:global>
.preview-notice{padding:8px 24px;background:#E6F4FF;color:#000000E0;text-align:center;font-size:13px}.preview-nav{display:flex;justify-content:space-between;align-items:center;gap:16px;max-width:1200px;margin:auto;padding:16px 24px}.preview-nav>div{display:flex;gap:24px}.preview-nav a:focus-visible{outline:2px solid #1677FF;outline-offset:4px}.preview-nav a:hover{text-decoration:underline}@media(max-width:600px){.preview-notice{font-size:12px}.preview-nav{padding:12px 16px}.preview-nav>div{gap:12px;font-size:13px}}
</style>
