# Fixed Gin listener; the existing Medusa runtime is not used.
GIN_API_ORIGIN=http://127.0.0.1:9100
# Match Gin's STOREFRONT_ORIGIN exactly (no trailing slash).
# A missing value keeps draft cart commands disabled.
STOREFRONT_ORIGIN=http://127.0.0.1:9300

# Independent shared 32-byte hex HMAC key for Astro -> Gin customer requests.
# CUSTOMER_BRIDGE_KEY=replace-with-64-lowercase-hex-characters
