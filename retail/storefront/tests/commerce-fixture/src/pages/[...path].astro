---
import GinProductActions from '../../../../src/components/products/gin-product-actions'
import {loadProduct} from '../../../../src/lib/products'
import styles from '../../../../src/components/products/styles.module.css'
const cart=Astro.url.pathname==='/dk-en/cart'
const product=cart?null:await loadProduct(process.env.STOREFRONT_TEST_GIN,'browser-add-product',{region_id:'fixture-region'})
if(!cart&&!product)throw Error('Owned product unavailable')
Astro.response.headers.set('Cache-Control','private, no-store')
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Owned commerce fixture</title><link rel="icon" href="data:,"/></head><body>
{cart?<main><h1>Owned cart destination</h1></main>:product&&<main class={styles.page}><section style="max-width:520px" data-testid="real-product-actions"><GinProductActions product={product} segment="dk-en" initialLocation={Astro.url.pathname+Astro.url.search} initialVariantID="browser-add-v" regionID="fixture-region" currency="eur" commerceEnabled={!Astro.url.searchParams.has('closed')} client:load/></section></main>}
</body></html>
<style is:global>
 *,::before,::after{box-sizing:border-box;border-width:0;border-style:solid}body{margin:0;font-family:Arial,sans-serif;font-size:16px;line-height:1.5;color:black}
 h1,h2,h3,p,dl,dd,fieldset,legend,ul{margin:0;padding:0}button,input{font:inherit;color:inherit;background:transparent;padding:0}button{cursor:pointer}
 svg,img{vertical-align:middle}img{display:block;max-width:100%;height:auto}a{color:inherit;text-decoration:inherit}
 .inline-block{display:inline-block}.align-middle{vertical-align:middle}.shrink-0{flex-shrink:0}.mt-4{margin-top:16px}
 :root{--storefront-max-width:1200px}
</style>
