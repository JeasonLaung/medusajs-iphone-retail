---
import Probe from '../probe'
const segment=Astro.url.pathname.split('/')[1]
if (!/^dk-(en|zh)$/.test(segment)) return new Response(null,{status:404})
---
<html lang={segment.endsWith('-zh')?'zh-CN':'en'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="data:,"/><title>Artificial cart fixture</title><link rel="canonical" href={`https://shop.example${Astro.url.pathname}`}/></head><body>
 <Probe reference={Astro.url.searchParams.get('reference')==='1'} segment={segment} mode={Astro.url.searchParams.get('mode')??'full'} client:load/>
</body></html>
<style is:global>
 *,::before,::after{box-sizing:border-box;border-width:0;border-style:solid}body{margin:0;font-family:Arial,sans-serif;font-size:16px;line-height:1.5;color:black}
 h1,h2,h3,p,dl,dd,fieldset,legend,ul{margin:0;padding:0}button,input{font:inherit;color:inherit;background:transparent;padding:0}button{cursor:pointer}
 svg,img{vertical-align:middle}img{display:block;max-width:100%;height:auto}a{color:inherit;text-decoration:inherit}
 .inline-block{display:inline-block}.align-middle{vertical-align:middle}.shrink-0{flex-shrink:0}.mt-4{margin-top:16px}.font-bold{font-weight:700}
 :root{--storefront-max-width:1200px}
</style>
