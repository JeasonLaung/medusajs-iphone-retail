APP_BIND=127.0.0.1
APP_PORT=9100
APP_ENV=development
# Dedicated migration database. Never use iphone0902's database.
MYSQL_DSN=retail:replace-me@tcp(127.0.0.1:13307)/eurorefurb_retail?charset=utf8mb4&parseTime=true&loc=UTC
DB_MAX_OPEN=8
PUBLIC_ASSET_ROOT=../../medusa-store/apps/storefront/public
LEGACY_PUBLIC_UPLOAD_ROOT=../../medusa-store/apps/backend/static
PRIVATE_UPLOAD_ROOT=.private-files
SESSION_SECURE=false
# Explicit new application Redis; never reuse Medusa sessions/namespace.
SESSION_REDIS_URL=redis://127.0.0.1:16379/0
SESSION_REDIS_PREFIX=eurorefurb:development:v1:
ADMIN_ORIGIN=http://127.0.0.1:9200

# Explicit new storefront shop binding; channel comes from its active default.
STOREFRONT_STORE_ID=replace-with-imported-store-id
# Windows dedicated eurorefurb_local_trial only: start.bat explicitly enables
# draft cart/address/manual delivery operations. Never enables payment or mail.
LOCAL_PREVIEW_CART_ENABLED=false
# Existing product/SKU/base price/initial warehouse inventory commands only.
# Enables local operation gates; never seeds products or modifies stock itself.
LOCAL_PREVIEW_PRODUCT_ENTRY_ENABLED=false
# Dedicated Windows preview only; requires a real Mollie test key and the
# explicit development loopback setting below. Configures checkout/completion,
# stock reservations and a separate local order-number range (1,000,000,001+).
LOCAL_PREVIEW_PAYMENT_ENABLED=false
# Dedicated Windows preview only: unlock existing device allocation/packing/
# shipment registration. Does not seed devices or modify stock/orders itself.
LOCAL_PREVIEW_FULFILLMENT_ENABLED=false
# Dedicated Windows preview only: enable customer applications and Admin review.
# Does not invent buyback prices/devices, send mail or transfer funds.
LOCAL_PREVIEW_BUYBACK_ENABLED=false
# Dedicated Windows preview only: requests, review, device receipt and repair
# return registration. Does not enable refund/payment workers or seed ownership.
LOCAL_PREVIEW_AFTER_SALES_ENABLED=false
# Dedicated Windows preview only: warehouse users and scoped access. Does not
# create accounts, grant warehouse access, seed devices or alter quantity stock.
LOCAL_PREVIEW_WAREHOUSE_USERS_ENABLED=false
# Warehouse management/device-source entry, independent of employee access.
# Requires existing device identity/command gates; creates no warehouse/device.
LOCAL_PREVIEW_WAREHOUSE_MANAGEMENT_ENABLED=false
# Optional cart HTTP origin; omission keeps cart HTTP routes unavailable.
# cart.create/cart.access database capabilities remain disabled by default.
# STOREFRONT_ORIGIN=http://127.0.0.1:9300

# New customer identities only. Disabled until explicitly configured.
CUSTOMER_AUTH_ENABLED=false
# Independent persistent AES-256 keyring; retain old keys for queued intents.
# CUSTOMER_KEY_ACTIVE=key-1
# CUSTOMER_KEYRING_JSON={"key-1":"replace-with-64-lowercase-hex-characters"}

# Independent shared 32-byte hex HMAC key for Astro -> Gin customer requests.
# CUSTOMER_BRIDGE_KEY=replace-with-64-lowercase-hex-characters

# Explicit separate worker only: go run ./cmd/send-verification-mail [--once]
# API startup never sends mail. Keep disabled for ordinary development.
CUSTOMER_VERIFICATION_MAIL_ENABLED=false
# Registration mail source: database uses the explicitly selected Admin mailbox.
# Existing explicit environment bootstrap remains available for isolated setup.
REGISTRATION_MAIL_SOURCE=database
NOTIFICATION_MAIL_ENABLED=false
# Windows preview: validate the existing mailbox configuration UI at startup.
# This flag never starts send-verification-mail/send-order-mail workers.
LOCAL_PREVIEW_NOTIFICATION_MAIL_ENABLED=false
# MERCHANT_KEY_ACTIVE=merchant-key-1
# MERCHANT_KEYRING_JSON={"merchant-key-1":"replace-with-independent-64-lowercase-hex-characters"}
# Never place these credentials in storefront/public environment variables.
# REGISTRATION_RESEND_API_KEY=re_replace-with-dedicated-sending-key
# REGISTRATION_MAIL_FROM=EuroRefurb <verified-sender@example.com>
# REGISTRATION_MAIL_REPLY_TO=support@example.com

# Comma-separated IDs of installed manual flat-rate shipping providers only.
# Omission exposes no manual delivery options; database names never register code.
# MANUAL_SHIPPING_PROVIDER_IDS=replace-with-registered-manual-provider-id
# 0043 shipping command gate defaults disabled; migrations never activate writes.

# Explicit first hosted Mollie checkout. No provider calls occur at startup.
# SQL cart checkout/completion gates and region/provider bindings are separate.
CHECKOUT_PAYMENT_ENABLED=false
# Separately enable payment-aware region/locale saves and restore commands.
# Requires checkout, its keyring/adapters and the SQL cart-context gate.
CHECKOUT_CONTEXT_PAYMENT_ENABLED=false
# Dedicated Windows preview only; start.bat explicitly configures v1 review
# reads/submissions/moderation without importing or approving any review.
LOCAL_PREVIEW_REVIEWS_ENABLED=false
# Explicit development/test-key/loopback only. Return GET verifies payment;
# local webhook is omitted because Mollie cannot reach a loopback listener.
MOLLIE_LOCAL_TEST_WITHOUT_WEBHOOK=false
# Independently enable the known-reference receiver; SQL notification,
# checkout/completion and inventory gates are still explicit and default closed.
MOLLIE_NOTIFICATIONS_ENABLED=false
# Refund commands remain independently disabled; also require explicit migration
# 0084, SQL refund runtime v2 enabled and dedicated order.refund.write grants.
ORDER_REFUNDS_ENABLED=false
# Recovery runs only in the separate process-order-refunds worker, never API startup.
# Run separately: go run ./cmd/process-mollie-notifications [--once]
# Uses the same shop, payment keyring, registered manual shipping IDs and Mollie
# credentials as checkout. API startup never runs this worker or changes schema.
# PAYMENT_KEY_ACTIVE=payment-key-1
# PAYMENT_KEYRING_JSON={"payment-key-1":"replace-with-independent-64-lowercase-hex-characters"}
# MOLLIE_API_KEY=test_replace-with-dedicated-sandbox-key
# Optional server-owned PEM CA bundle, e.g. for a trusted local TLS proxy.
# MOLLIE_CA_FILE=/absolute/path/to/ca.pem
# Public API origin used for Mollie callback URLs; loopback only for development.
# MOLLIE_BACKEND_ORIGIN=http://127.0.0.1:9100
# Keep PAYMENT keys available while payment/notification envelopes reference them.
# PayPal and PayPal Card are not activated by this switch.

# Explicit worker: go run ./cmd/send-order-mail [--once]. Uses approved Admin mailbox.
ORDER_MAIL_ENABLED=false

# Independent native order supplemental payment worker; explicit SQL gates also required.
ORDER_PAYMENTS_ENABLED=false
# Windows preview start.bat: explicitly configure local supplemental-payment
# gates and run one native process-order-payments worker. Requires the two
# independent ORDER_PAYMENTS/MOLLIE_NOTIFICATIONS flags above; no refunds/mail.
LOCAL_PREVIEW_ORDER_PAYMENTS_ENABLED=false
# Windows preview only: explicit test-key refund v4 configuration and one native
# process-order-refunds worker. Requires ORDER_REFUNDS_ENABLED=true separately.
LOCAL_PREVIEW_REFUNDS_ENABLED=false

# Committed new-account order/buyback/after-sales events. API never sends mail.
# Apply 0105, then explicitly run go run ./cmd/send-customer-event-mail [--once].
# Requires CUSTOMER and MERCHANT persistent keyrings and an approved Admin mailbox.
CUSTOMER_EVENT_MAIL_ENABLED=false
