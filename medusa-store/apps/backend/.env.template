STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Mail: stable secret used to encrypt Resend credentials stored in the database.
# If omitted, the application uses COOKIE_SECRET (must not be the starter value).
MAIL_ENCRYPTION_KEY=
# Public backend HTTPS origin for receiving webhooks and marketing unsubscribe links.
MAIL_PUBLIC_URL=https://api.example.com

# Payment integrations. Use public HTTPS URLs for payment webhooks.
MEDUSA_BACKEND_URL=http://localhost:9001
# Public Admin origin or full /app URL used by notification action links.
WEBHOOK_ADMIN_URL=
# Explicit timezone for order and after-sales notification timestamps.
WEBHOOK_TIME_ZONE=Asia/Shanghai
STOREFRONT_URL=http://localhost:8000

# PayPal: connect your Sandbox/Live account in Admin > Settings > PayPal.
# Set a stable random encryption key before connecting your account.
PAYPAL_ENCRYPTION_KEY=
PAYPAL_ENCRYPTION_STRICT=true

# Configure Mollie in Admin > Settings > Mollie, or use a test_ key here.
MOLLIE_API_KEY=
MOLLIE_REDIRECT_URL=http://localhost:8000/api/mollie-return
# Public backend origin reachable by Mollie (may differ from the local backend).
MOLLIE_WEBHOOK_BASE_URL=
# Used to encrypt the API key saved by Admin > Settings > Mollie.
MOLLIE_ENCRYPTION_KEY=
