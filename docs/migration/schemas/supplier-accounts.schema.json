{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eurorefurb:api:supplier-accounts",
  "title": "Supplier account wire contracts; Gin handlers not yet implemented",
  "$defs": {
    "Email": { "type": "string", "minLength": 3, "maxLength": 254, "format": "email", "pattern": "^[\\x21-\\x7e]+$" },
    "OrderIDsInput": { "type": "array", "maxItems": 200, "items": { "$ref": "urn:eurorefurb:api:common#/$defs/ID" }, "description": "Duplicates accepted as legacy input; normalize to unique IDs before command hash, authorization, storage and response. Empty means no orders." },
    "CreateRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["email", "password", "source_id", "order_ids"],
      "properties": {
        "email": { "$ref": "#/$defs/Email" },
        "password": { "type": "string", "minLength": 12, "maxLength": 128, "description": "Do not trim, case-fold, log, persist as request JSON, hash with plain SHA, or return. Length measured as Unicode code points. Secure password KDF chosen and verified in T014." },
        "source_id": { "$ref": "urn:eurorefurb:api:common#/$defs/ID" },
        "order_ids": { "$ref": "#/$defs/OrderIDsInput" }
      }
    },
    "BindingRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "order_ids", "access_mode"],
      "properties": {
        "source_id": { "$ref": "urn:eurorefurb:api:common#/$defs/ID" },
        "order_ids": { "$ref": "#/$defs/OrderIDsInput" },
        "access_mode": { "const": "supplier", "type": "string", "description": "Explicitly replaces target staff access with supplier restrictions; not additive admin permissions. Target cannot be actor." }
      }
    },
    "Account": {
      "type": "object", "additionalProperties": false,
      "required": ["staff_id", "email", "source_id", "order_ids", "enabled", "access_mode", "version", "permission_version", "created_at", "updated_at"],
      "properties": {
        "staff_id": { "$ref": "urn:eurorefurb:api:common#/$defs/ID" },
        "email": { "$ref": "#/$defs/Email" },
        "source_id": { "$ref": "urn:eurorefurb:api:common#/$defs/ID" },
        "order_ids": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "urn:eurorefurb:api:common#/$defs/ID" } },
        "enabled": { "type": "boolean" },
        "access_mode": { "type": "string", "const": "supplier" },
        "version": { "$ref": "urn:eurorefurb:api:common#/$defs/Revision" },
        "permission_version": { "$ref": "urn:eurorefurb:api:common#/$defs/Revision" },
        "created_at": { "$ref": "urn:eurorefurb:api:common#/$defs/UTCDateTime" },
        "updated_at": { "$ref": "urn:eurorefurb:api:common#/$defs/UTCDateTime" }
      }
    },
    "DetailResponse": {
      "type": "object", "additionalProperties": false, "required": ["account"],
      "properties": { "account": { "$ref": "#/$defs/Account" } }
    },
    "ListQuery": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 100000, "default": 0 },
        "q": { "type": "string", "minLength": 1, "maxLength": 254, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
        "source_id": { "$ref": "urn:eurorefurb:api:common#/$defs/ID" },
        "enabled": { "type": "boolean" },
        "order": { "type": "string", "enum": ["created_at", "-created_at", "email", "-email"], "default": "-created_at" }
      }
    },
    "ListResponse": {
      "type": "object", "additionalProperties": false, "required": ["accounts", "count", "limit", "offset"],
      "properties": {
        "accounts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/Account" } },
        "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "offset": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    }
  }
}
